{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stelix",
  "version": "0.1.1",
  "identifier": "com.stelix.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stelix File Manager 星索",
        "width": 1100,
        "height": 700,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "visible": false,
        "decorations": false,
        "devtools": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
